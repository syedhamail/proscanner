# Copy this to .env for local dev, or set these as environment variables
# in your Northflank service.

# --- Core ---
# Your real domain — used for canonical URLs, sitemap.xml, and Open Graph/Twitter
# share previews. No trailing slash.
SITE_URL=https://proscanner.com.pk

# PostgreSQL connection string (Northflank gives you one when you add
# its free Postgres add-on). Leave this BLANK for local testing — the app
# will automatically use a local SQLite file instead. Only fill this in
# once you actually have a real Postgres connection string.
DATABASE_URL=

# Random long string used to sign session cookies. Set a real one in production.
SECRET_KEY=change-this-to-a-long-random-string

# --- Resend (contact form + verification emails) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Pro Scanner <onboarding@resend.dev>

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI to add there: https://yourdomain.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (https://github.com/settings/developers) ---
# Authorization callback URL to add there: https://yourdomain.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Paddle Billing (https://vendors.paddle.com) ---
# Client-side token: Developer Tools -> Authentication -> Client-side tokens
PADDLE_CLIENT_TOKEN=
# "sandbox" while testing, "production" when you go live
PADDLE_ENV=sandbox
# Create one Price per plan in Paddle (Catalog -> Prices) and paste their IDs here
PADDLE_BASIC_PRICE_ID=
PADDLE_ADVANCED_PRICE_ID=
PADDLE_PREMIUM_PRICE_ID=
# Developer Tools -> Notifications -> your webhook -> "Secret key"
PADDLE_WEBHOOK_SECRET=

# --- Admin panel (only reachable at /admin — no link anywhere on the site) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-something-strong

PORT=5000
